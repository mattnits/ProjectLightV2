BasedOnStyle: LLVM

IndentWidth: 4
TabWidth: 4
UseTab: Never

ColumnLimit: 100

BreakBeforeBraces: Custom

BraceWrapping:
  AfterNamespace: true
  AfterClass: false
  AfterStruct: false
  AfterEnum: false
  AfterFunction: false
  AfterControlStatement: Never
  AfterUnion: false
  BeforeCatch: false
  BeforeElse: false

AllowShortFunctionsOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false

PointerAlignment: Left
ReferenceAlignment: Left

SortIncludes: true